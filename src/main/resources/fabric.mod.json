{
	"schemaVersion": 1,
	"id": "${id}",
	"version": "${version}",
	"name": "${name}",
	"description": "Aims to make mapart creation as convenient and enjoyable as possible right in the game: flexibly generate a schematic, save maps as image files, and more",
	"authors": [
		"Redheris"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/mapart-helper",
		"sources": "https://github.com/Redheris/Mapart-Helper"
	},
	"license": "LGPL-3.0",
	"icon": "assets/maparthelper/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"rh.maparthelper.MapartHelper"
		],
		"client": [
			"rh.maparthelper.MapartHelperClient"
		],
		"modmenu": [
			"rh.maparthelper.compat.ModMenuIntegration"
		]
	},
	"mixins": [
		"maparthelper.mixins.json"
	],
	"accessWidener": "${id}.classtweaker",
	"depends": {
		"fabricloader": ">=${fabric_loader}",
		"minecraft": "${minecraft}",
		"fabric-api": "*",
		"yet_another_config_lib_v3": "*"
	}
